{
  "name": "David Quispe portfolio",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "jekyll",
  "workspaceFolder": "/srv/jekyll",
  "overrideCommand": false,
  "shutdownAction": "none",
  "remoteUser": "portfolio",
  "forwardPorts": [8080, 35729],
  "portsAttributes": {
    "8080": {
      "label": "Portfolio",
      "onAutoForward": "notify"
    },
    "35729": {
      "label": "Jekyll LiveReload",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "sissel.shopify-liquid", "yzhang.markdown-all-in-one"],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.configPath": ".prettierrc",
        "editor.formatOnSave": true
      }
    }
  }
}
