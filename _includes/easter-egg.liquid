<dialog id="wipeout-modal" class="wipeout-modal easter-egg-modal" aria-label="Aero Fighters SNES (1993)" data-wipeout-modal>
  <div class="wipeout-frame">
    <header class="wipeout-header">
      <div class="wipeout-title-group">
        <span class="wipeout-tag-prefix" id="easter-egg-tag-prefix">SNES //</span>
        <h2 class="wipeout-title" id="easter-egg-title">AERO FIGHTERS (1993)</h2>
        <span class="wipeout-badge" id="easter-egg-badge">SPC700 AUDIO // 60 FPS</span>
      </div>
      <div class="wipeout-tools">
        <button type="button" class="wipeout-tool-btn" data-wipeout-help title="Controls guide" aria-label="Controls guide">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.001"/><path d="M10 8h.001"/><path d="M14 8h.001"/><path d="M18 8h.001"/><path d="M8 12h.001"/><path d="M12 12h.001"/><path d="M16 12h.001"/><path d="M6 16h12"/>
          </svg>
          <span class="btn-text">Controls</span>
        </button>
        <button type="button" class="wipeout-tool-btn" data-wipeout-p2 title="Player 2 Join / Start" aria-label="Player 2 Join">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span class="btn-text">2P Join</span>
        </button>
        <button type="button" class="wipeout-tool-btn" data-wipeout-audio title="Toggle audio" aria-label="Toggle audio">
          <svg
            class="audio-on-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
          </svg>
          <svg
            class="audio-off-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            style="display:none;"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
          </svg>
          <span class="btn-text audio-label">Audio</span>
        </button>
        <button type="button" class="wipeout-tool-btn" data-wipeout-restart title="Restart game" aria-label="Restart game">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
          </svg>
          <span class="btn-text">Restart</span>
        </button>
        <button type="button" class="wipeout-tool-btn" data-wipeout-fullscreen title="Fullscreen" aria-label="Fullscreen">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
          </svg>
          <span class="btn-text">Fullscreen</span>
        </button>
        <button type="button" class="wipeout-close-btn" data-wipeout-close aria-label="Close game">
          <span>✕ Close</span>
        </button>
      </div>
    </header>

    <div class="wipeout-viewport" id="wipeout-game-viewport">
      <canvas id="canvas" oncontextmenu="event.preventDefault()" tabindex="-1" aria-label="Game canvas"></canvas>

      <!-- Music Track Toast HUD -->
      <div class="wipeout-track-toast" id="wipeout-track-toast" aria-live="polite" hidden>
        <span class="track-icon">♪</span>
        <span class="track-info">
          <strong class="track-name" id="wipeout-track-name">STAGE BGM</strong>
          <span class="track-artist">SONY SPC700 // S-DSP</span>
        </span>
      </div>

      <!-- Loading overlay -->
      <div class="wipeout-loader" id="wipeout-loader">
        <div class="wipeout-spinner"></div>
        <div class="wipeout-loader-status" id="wipeout-status">Starting emulator and SNES audio...</div>
        <div class="wipeout-progress-bar">
          <div class="wipeout-progress-fill" id="wipeout-progress-fill" style="width: 0%;"></div>
        </div>
        <div class="wipeout-loader-sub" id="wipeout-loader-sub">Snes9x WebAssembly • 16-Bit SPC700 Audio • 60 FPS</div>
      </div>

      <!-- Crash Recovery Overlay -->
      <div class="wipeout-error-overlay" id="wipeout-error-overlay" hidden>
        <div class="wipeout-error-box">
          <div class="error-badge">⚠️ ENGINE STATUS</div>
          <h3 id="wipeout-error-title">Execution Interrupted</h3>
          <p id="wipeout-error-desc">An exception was caught in the WebAssembly module. You can cleanly restart the game below.</p>
          <div class="error-actions">
            <button type="button" class="wipeout-btn-primary" data-wipeout-retry>🔄 Restart</button>
            <button type="button" class="wipeout-btn-secondary" data-wipeout-error-close>Close</button>
          </div>
        </div>
      </div>

      <!-- Controls legend drawer -->
      <div class="wipeout-help-overlay" id="wipeout-help-overlay" hidden>
        <div class="wipeout-help-box">
          <div class="help-box-header">
            <h3 id="help-box-game-title">Controls Guide — Aero Fighters (SNES)</h3>
            <span class="help-sub">Touchscreen, 1P &amp; 2P Co-op Keyboard, and USB / Bluetooth Gamepads</span>
          </div>

          <div class="wipeout-help-sections">
            <div class="help-section">
              <h4 class="help-section-title">🕹️ TOUCH CONTROLS</h4>
              <div class="wipeout-help-grid">
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch kbd-thrust">JOYSTICK</kbd></span>
                  <span class="help-desc">Analog 360° Movement</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch kbd-shoot">B</kbd></span>
                  <span class="help-desc">Button B</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch">A</kbd></span>
                  <span class="help-desc">Button A</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch kbd-brake">AUTO</kbd></span>
                  <span class="help-desc">Auto-Fire Toggle</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch">START</kbd></span>
                  <span class="help-desc">Start / Pause</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch">SELECT</kbd></span>
                  <span class="help-desc">Select</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd class="kbd-touch">2P JOIN</kbd></span>
                  <span class="help-desc">Player 2 Join</span>
                </div>
              </div>
            </div>

            <div class="help-section">
              <h4 class="help-section-title">⌨️ KEYBOARD — PLAYER 1</h4>
              <div class="wipeout-help-grid">
                <div class="help-item">
                  <span class="help-keys"><kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd></span>
                  <span class="help-desc">Move</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>J</kbd> / <kbd>Z</kbd> / <kbd>Space</kbd></span>
                  <span class="help-desc">B</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>K</kbd> / <kbd>X</kbd></span>
                  <span class="help-desc">A</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>C</kbd></span>
                  <span class="help-desc">Auto-Fire</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>Enter</kbd></span>
                  <span class="help-desc">Start</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>Shift</kbd></span>
                  <span class="help-desc">Select</span>
                </div>
              </div>
            </div>

            <div class="help-section">
              <h4 class="help-section-title">⌨️ KEYBOARD — PLAYER 2 (CO-OP)</h4>
              <div class="wipeout-help-grid">
                <div class="help-item">
                  <span class="help-keys"><kbd>▲</kbd> <kbd>▼</kbd> <kbd>◀</kbd> <kbd>▶</kbd> / <kbd>8546</kbd></span>
                  <span class="help-desc">Move</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>Num 1</kbd> / <kbd>[</kbd> / <kbd>O</kbd> / <kbd>1</kbd></span>
                  <span class="help-desc">B</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>Num 2</kbd> / <kbd>]</kbd> / <kbd>P</kbd> / <kbd>2</kbd></span>
                  <span class="help-desc">A</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>V</kbd></span>
                  <span class="help-desc">Auto-Fire</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>Num Enter</kbd> / <kbd>\</kbd> / <kbd>3</kbd></span>
                  <span class="help-desc">Start / Join</span>
                </div>
                <div class="help-item">
                  <span class="help-keys"><kbd>Num 0</kbd> / <kbd>;</kbd></span>
                  <span class="help-desc">Select</span>
                </div>
              </div>
            </div>

            <div class="help-section help-section-gamepad">
              <h4 class="help-section-title">🎮 GAMEPADS (1P &amp; 2P CO-OP)</h4>
              <p class="help-gamepad-desc">
                Gamepad 1: Player 1 • Gamepad 2: Player 2 • D-Pad / Stick: Move • B: Fire • A: Bomb • Start: Join / Pause
              </p>
            </div>
          </div>

          <div class="help-box-footer">
            <button type="button" class="wipeout-btn-primary" data-wipeout-help-dismiss>Play</button>
          </div>
        </div>
      </div>

      <!-- Virtual on-screen touch gamepad for mobile/tablets -->
      <div class="wipeout-touch-controls" id="wipeout-touch-controls" aria-hidden="true">
        <!-- Left Side: Ergonomic Virtual Analog Joystick -->
        <div class="touch-side touch-side-left">
          <div class="touch-joystick-wrap" id="touch-joystick-zone">
            <div class="touch-joystick-base" id="touch-joystick-base">
              <div class="touch-joystick-knob" id="touch-joystick-knob"></div>
              <span class="joystick-tick tick-u" data-button="82">▲</span>
              <span class="joystick-tick tick-d" data-button="81">▼</span>
              <span class="joystick-tick tick-l" data-button="80">◀</span>
              <span class="joystick-tick tick-r" data-button="79">▶</span>
            </div>
          </div>
        </div>

        <!-- Center Top Utility Controls -->
        <div class="touch-center-top">
          <button type="button" class="touch-btn touch-pill touch-cam" data-button="4" data-action="select" aria-label="Select">
            <span class="pill-icon">🔘</span>
            <span class="pill-label">SELECT</span>
          </button>
          <button type="button" class="touch-btn touch-pill touch-pause" data-button="40" data-action="start" aria-label="Start">
            <span class="pill-icon">▶</span>
            <span class="pill-label">START</span>
          </button>
          <button type="button" class="touch-btn touch-pill touch-p2" data-action="p2-join" aria-label="Player 2 Join">
            <span class="pill-icon">👥</span>
            <span class="pill-label">2P JOIN</span>
          </button>
        </div>

        <!-- Right Side: Action Buttons -->
        <div class="touch-side touch-side-right">
          <button type="button" class="touch-btn touch-autofire" id="touch-autofire-btn" data-button="6" aria-label="Auto Fire toggle">
            <span class="autofire-icon">⚡</span>
            <span class="autofire-txt" id="touch-autofire-label">AUTO: OFF</span>
          </button>
          <div class="touch-actions-cluster">
            <button type="button" class="touch-btn touch-action touch-shoot" data-button="27" data-action="shoot" aria-label="B">
              <span class="action-main" id="action-btn-main-label">B</span>
            </button>
            <button
              type="button"
              class="touch-btn touch-action touch-thrust touch-bomb"
              data-button="29"
              data-action="bomb"
              aria-label="A"
            >
              <span class="action-main" id="action-btn-bomb-label">A</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Desktop controls summary bar at bottom -->
    <footer class="wipeout-footer">
      <div class="wipeout-controls-hint" id="easter-egg-footer-hint">
        <span><kbd>WASD</kbd> 1P Move</span>
        <span><kbd>J</kbd> / <kbd>Z</kbd> 1P B</span>
        <span><kbd>K</kbd> / <kbd>X</kbd> 1P A</span>
        <span><kbd>▲▼◀▶</kbd> 2P Move</span>
        <span><kbd>Num 1</kbd> / <kbd>[</kbd> 2P B</span>
        <span><kbd>Num 2</kbd> / <kbd>]</kbd> 2P A</span>
        <span><kbd>Enter</kbd> Start</span>
        <span><kbd>Esc</kbd> Close</span>
      </div>
    </footer>
  </div>
</dialog>

<!-- Notification pill that flashes when easter egg is triggered -->
<div id="wipeout-easter-egg-banner" class="wipeout-egg-banner" aria-live="polite" hidden>
  <span class="banner-glitch-icon">⚡</span>
  <span class="banner-text" id="easter-egg-banner-text">AG-SYSTEMS // AERO FIGHTERS (SNES) ACTIVATED</span>
</div>
