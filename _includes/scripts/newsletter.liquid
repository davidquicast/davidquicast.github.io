{% assign subscription_endpoint = site.newsletter.endpoint | newsletter_endpoint %}
{% if site.newsletter.enabled and subscription_endpoint != '' %}
  {% capture newsletter_number %}{% increment newsletter_form_count %}{% endcapture %}
  {% assign newsletter_id = newsletter_number | prepend: 'newsletter-email-' %}
  <form class="newsletter-form" data-newsletter action="{{ subscription_endpoint | escape }}" method="post">
    <label for="{{ newsletter_id }}">Email address</label>
    <div class="newsletter-controls">
      <input id="{{ newsletter_id }}" name="email" type="email" autocomplete="email" inputmode="email" required>
      <button type="submit">Subscribe</button>
    </div>
    <p class="newsletter-status" data-newsletter-status role="status" aria-live="polite"></p>
  </form>
{% endif %}
