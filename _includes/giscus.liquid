{% if site.giscus.repo != blank and site.giscus.repo_id != blank and site.giscus.category_id != blank %}
  <section class="comments-section" aria-label="Discussion">
    <div
      id="giscus_thread"
      data-giscus
      data-repo="{{ site.giscus.repo | escape }}"
      data-repo-id="{{ site.giscus.repo_id | escape }}"
      data-category="{{ site.giscus.category | escape }}"
      data-category-id="{{ site.giscus.category_id | escape }}"
      data-mapping="{{ site.giscus.mapping | default: 'pathname' | escape }}"
      data-strict="{{ site.giscus.strict | default: '1' | escape }}"
      data-reactions-enabled="{{ site.giscus.reactions_enabled | default: '1' | escape }}"
      data-emit-metadata="{{ site.giscus.emit_metadata | default: '0' | escape }}"
      data-input-position="{{ site.giscus.input_position | default: 'bottom' | escape }}"
      data-lang="{{ site.active_lang | split: '-' | first | escape }}"
    ></div>
    <noscript>
      <p>Enable JavaScript to load the discussion from <a href="https://giscus.app/">Giscus</a>.</p>
    </noscript>
  </section>
{% endif %}
