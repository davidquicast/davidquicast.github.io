{% assign research_cover = site.data.research_covers[include.paper.id] %}
{% if research_cover %}
  <img
    src="{{ research_cover.thumbnail | relative_url }}"
    srcset="{{ research_cover.srcset }}"
    sizes="{{ include.sizes | default: '(max-width: 700px) 72px, (pointer: coarse) 108px, 88px' }}"
    width="{{ research_cover.width }}"
    height="{{ research_cover.height }}"
    alt="{{ research_cover.alt | escape }}"
    loading="{{ include.loading | default: 'lazy' }}"
    decoding="async"
    {% if include.loading == 'eager' %}
      fetchpriority="{{ include.priority | default: 'auto' }}"
    {% endif %}
  >
{% endif %}
