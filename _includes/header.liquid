<header class="site-header" data-ui>
  <div class="site-header-inner">
    {% if page.layout != 'about' %}
      <nav class="main-navigation" id="main-navigation" aria-label="{{ 'navigation.main' | ui_label }}">
        <a
          class="top-link header-home-link"
          data-feed-link
          href="{{ '/' | relative_url }}"
          aria-label="David Quispe"
        >
          <span class="header-name">David Quispe</span>
        </a>
      </nav>
    {% else %}
      <div class="header-lead-space" aria-hidden="true"></div>
    {% endif %}
    <div class="rail-tools">
      {% if page.layout != 'about' %}
        <a
          class="header-tool header-about-tool"
          href="{{ '/about/' | relative_url }}"
          data-content-overlay
          aria-label="{{ 'navigation.about' | ui_label }}"
          title="{{ 'navigation.about' | ui_label }}"
        >
          {% include icon.liquid name='profile' %}
        </a>
      {% endif %}
      {% if site.search_enabled and page.layout != 'about' -%}
        <button
          class="search-toggle header-tool"
          type="button"
          aria-label="{{ 'search.title' | ui_label }}"
          data-search-open
          data-enable-with-js
          hidden
        >
          {% include icon.liquid name='search' %}
        </button>
      {%- endif %}
      {% if site.enable_darkmode -%}
        <button class="theme-toggle header-tool theme-switch" type="button" aria-label="{{ 'theme.to_dark' | ui_label }}" hidden>
          <span class="theme-switch-track" aria-hidden="true">
            <span class="theme-switch-thumb"></span>
            <span class="theme-switch-icon theme-switch-sun">{% include icon.liquid name='sun' %}</span>
            <span class="theme-switch-icon theme-switch-moon">{% include icon.liquid name='theme' %}</span>
          </span>
        </button>
      {%- endif %}
      {% include language-switcher.liquid %}
    </div>
  </div>
</header>
<script>
  document.dispatchEvent(new Event('portfolio:header-ready'));
</script>
