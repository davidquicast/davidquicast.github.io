<header class="site-header" data-ui>
  <div class="site-header-inner">
    <nav class="main-navigation" id="main-navigation" aria-label="{{ 'navigation.main' | ui_label }}">
      <a
        class="top-link"
        data-feed-link
        href="{{ '/' | relative_url }}"
        {% unless page.url contains '/about/' or page.url contains '/resume/' %}
          aria-current="page"
        {% endunless %}
      >
        {{- 'navigation.work' | ui_label: 'Work' -}}
      </a>
      <a
        class="top-link"
        href="{{ '/about/' | relative_url }}"
        data-content-overlay
        {% if page.url contains '/about/' or page.url contains '/resume/' %}
          aria-current="page"
        {% endif %}
      >
        {{- 'navigation.about' | ui_label -}}
      </a>
    </nav>
    <div class="rail-tools">
      {% if site.search_enabled and page.layout != 'about' -%}
        <button
          class="search-toggle header-tool"
          type="button"
          aria-label="{{ 'search.title' | ui_label }}"
          data-search-open
          data-enable-with-js
          hidden
        >
          {% include icon.liquid name='search' %}
        </button>
      {%- endif %}
      {% if site.enable_darkmode -%}
        <button class="theme-toggle header-tool" type="button" aria-label="{{ 'theme.to_dark' | ui_label }}" hidden>
          {% include icon.liquid name='theme' %}
        </button>
      {%- endif %}
      {% include language-switcher.liquid %}
    </div>
  </div>
</header>
<script>
  document.dispatchEvent(new Event('portfolio:header-ready'));
</script>
