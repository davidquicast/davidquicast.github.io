{% if site.disqus_shortname != blank and site.disqus_shortname != 'multi-language-al-folio' %}
  <section class="comments-section" aria-label="Discussion">
    <div id="disqus_thread" data-disqus="{{ site.disqus_shortname | escape }}" data-disqus-id="{{ page.id | default: page.url | escape }}"></div>
    <noscript>
      <p>Enable JavaScript to load the discussion from <a href="https://disqus.com/">Disqus</a>.</p>
    </noscript>
  </section>
{% endif %}
