{% capture author_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
{% assign page_title = page.title | default: author_name %}
{% if page.url == '/' %}{% assign page_title = author_name %}{% endif %}
{% case page.type %}
  {% when 'year' %}
    {% capture page_title %}Blog: {{ page.date | date: '%Y' }}{% endcapture %}
    {% capture archive_description %}Articles and technical notes by David Quispe published in {{ page.date | date: '%Y' }}.{% endcapture %}
  {% when 'tag' %}
    {% capture page_title %}Blog · Tag: {{ page.title | replace: '-', ' ' }}{% endcapture %}
    {% capture archive_description %}Articles and technical notes by David Quispe tagged {{ page.title | replace: '-', ' ' }}.{% endcapture %}
  {% when 'category' %}
    {% capture page_title %}Blog · Category: {{ page.title | replace: '-', ' ' }}{% endcapture %}
    {% capture archive_description %}Articles and technical notes by David Quispe in {{ page.title | replace: '-', ' ' }}.{% endcapture %}
{% endcase %}
{% assign description = page.description
  | default: archive_description
  | default: 'David Quispe is a systems engineer working across cybersecurity, AI safety and agent behavior. Explore projects, open-source contributions and technical writing.'
%}
{% assign research_social_image = '' %}
{% if page.paper %}{% assign research_social_image = site.data.research_covers[page.paper.id].image %}{% endif %}
{% assign media_social_image = '' %}
{% if page.collection == 'projects' %}{% assign media_social_image = site.data.project_media[page.slug].image %}{% endif %}
{% if page.layout == 'post' %}{% assign media_social_image = site.data.blog_covers[page.slug].image %}{% endif %}
{% assign social_image = page.og_image
  | default: page.image
  | default: research_social_image
  | default: media_social_image
  | default: site.og_image
  | absolute_url
%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>
  {{ page_title | escape }}
  {% unless page.url == '/' %} · {{ author_name | strip | escape }}{% endunless %}
</title>
<meta name="description" content="{{ description | strip_html | strip | escape }}">
<meta name="author" content="{{ author_name | strip | escape }}">
<meta name="color-scheme" content="{% if site.enable_darkmode %}light dark{% else %}light{% endif %}">
<meta name="theme-color" content="#f9f5ef">
{% if page.published == false or page.page_id == 'not_found' %}<meta name="robots" content="noindex,nofollow">{% endif %}
{% if site.serve_og_meta %}
  <meta property="og:site_name" content="David Quispe">
  <meta property="og:type" content="{% if page.layout == 'post' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:description" content="{{ description | strip_html | strip | escape }}">
  <meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}">
  <meta property="og:image" content="{{ social_image }}">
  <meta property="og:locale" content="{{ page | content_locale | og_locale }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  <meta name="twitter:description" content="{{ description | strip_html | strip | escape }}">
  <meta name="twitter:image" content="{{ social_image }}">
  <meta name="twitter:creator" content="@{{ site.data.socials.x_username }}">
{% endif %}
{% if page.layout == 'post' %}<meta property="article:published_time" content="{{ page.date | date_to_xmlschema }}">{% endif %}
{% if site.google_site_verification %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
{% if site.bing_site_verification %}<meta name="msvalidate.01" content="{{ site.bing_site_verification }}">{% endif %}
