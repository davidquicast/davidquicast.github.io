<!doctype html>
<html lang="{{ page | content_locale | locale_tag }}">
  <head>
    {% include metadata.liquid %}
    {% include schema-org.liquid %}
    <link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
    <link rel="icon" href="{{ '/assets/img/icon2.ico' | relative_url }}">
    <link rel="alternate" type="application/atom+xml" title="David Quispe" href="{{ '/feed.xml' | relative_url }}">
    <link rel="preload" href="{{ '/assets/fonts/editorial/inter-latin-500-normal.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ '/assets/fonts/editorial/inter-latin-400-normal.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ "/assets/css/readcv-interactions.css" | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/portfolio.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/editorial.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/wall.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/profile-shell.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/section-layout.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/about-refinement.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/motion.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/control-refinement.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/profile-connections.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/reader-typography.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet" href="{{ '/assets/css/easter-egg.css' | relative_url | bust_file_cache }}">
    {% include language-links.liquid %}
    {% include ui-labels.liquid %}
    {% include frontend-bootstrap.liquid %}
    {% if page.redirect and page.collection != 'projects' and page.layout != 'post' %}
      {% unless page.url == '/404.html' %}
        <meta http-equiv="refresh" content="3; url={% if page.redirect == true %}{{ '/' | relative_url }}{% else %}{{ page.redirect }}{% endif %}">
      {% endunless %}
    {% endif %}
  </head>
  <body
    data-content-overlay-host
    data-image-zoom="{% if site.enable_medium_zoom %}true{% else %}false{% endif %}"
    class="page-{{ page.page_id | default: page.layout | slugify }}{% if site.footer_fixed %} has-fixed-footer{% endif %}{% if site.navbar_fixed == false %} has-static-nav{% endif %}"
  >
    <a class="skip-link" href="#main">{{ 'labels.skip' | ui_label }}</a>
    {% include header.liquid %}
    <main id="main" tabindex="-1" class="site-main{% if page.layout == 'about' %} site-main-home{% endif %}">{{ content }}</main>
    {% include footer.liquid %}
    {% include content-overlay.liquid %}
    <script src="{{ '/assets/js/portfolio.js' | relative_url | bust_file_cache }}" defer></script>
    {% include search.liquid %}

    {% if page.layout == 'about' %}<script src="{{ '/assets/js/profile-links.js' | relative_url | bust_file_cache }}" defer></script>{% endif %}
    {% if page.layout == 'about' %}<script src="{{ '/assets/js/profile-feed.js' | relative_url | bust_file_cache }}" defer></script>{% endif %}
    <script src="{{ '/assets/js/readcv-interactions.js' | relative_url | bust_file_cache }}" defer></script>
    <script type="module" src="{{ '/assets/js/dist/editorial.js' | relative_url | bust_file_cache }}"></script>
    <script src="{{ '/assets/js/card-menu.js' | relative_url | bust_file_cache }}" defer></script>
    <script src="{{ '/assets/js/wall.js' | relative_url | bust_file_cache }}" defer></script>
    <script src="{{ '/assets/js/motion.js' | relative_url | bust_file_cache }}" defer></script>
    <script src="{{ '/assets/js/about-reader.js' | relative_url | bust_file_cache }}" defer></script>
    <script src="{{ '/assets/js/content-overlay.js' | relative_url | bust_file_cache }}" defer></script>
    {% include easter-egg.liquid %}
    <script src="{{ '/assets/js/easter-egg.js' | relative_url | bust_file_cache }}" defer></script>
    {% include optional-features.liquid %}
    {% include site-progress.liquid %}
    {% include scripts/analytics.liquid %}
  </body>
</html>
