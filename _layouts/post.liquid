---
layout: default
---
{% assign reading_time = content | number_of_words | divided_by: 200 | plus: 1 %}
<article class="editorial-post">
  <a class="back-link" href="{{ '/' | relative_url }}?view=writing">← {{ 'navigation.writing' | ui_label }}</a>
  <header class="article-header">
    {% if page.published == false %}
      <p class="draft-notice">{{ 'labels.local_draft' | ui_label }}</p>
    {% endif %}
    <h1 data-pretext="lines">{{ page.title }}</h1>
    {% if page.description %}
      <p class="article-deck" data-pretext>{{ page.description }}</p>
    {% endif %}
    <div class="article-byline">
      <span>David Quispe</span><time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | localized_date: 'long' }}</time>
      {%- unless page.external_source -%}
        <span>
          {{- reading_time }}
          {{ 'labels.minute_read' | ui_label -}}
        </span>
      {%- endunless %}
      {%- if page.last_updated -%}
        <span>
          {{- 'labels.updated' | ui_label }}
          {% include content-date.liquid value=page.last_updated %}
        </span>
      {%- endif %}
    </div>
    {% if page.tags.size > 0 %}
      <nav class="article-tags" aria-label="{{ 'labels.article_topics' | ui_label }}">
        {% for tag in page.tags -%}
          <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">{{ tag | replace: '-', ' ' }}</a>
        {%- endfor %}
      </nav>
    {% endif %}
  </header>
  <figure class="article-cover">{% include editorial-cover.liquid post=page loading="eager" sizes="(min-width: 1000px) 760px, 90vw" %}</figure>
  <div class="reading-layout">
    <aside class="reading-sidebar">
      <details class="article-outline">
        <summary>{{ 'labels.in_this_article' | ui_label }}</summary>
        <nav aria-label="{{ 'labels.on_this_page' | ui_label }}" id="article-toc"></nav>
      </details>
    </aside>
    <div class="prose article-content" id="markdown-content">{{ content }}</div>
  </div>
  {% if page.citation %}{% include citation.liquid %}{% endif %}
  {% if page.related_publications %}
    <div class="prose">
      <h2>References</h2>
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}
  {% assign more_posts = site.posts | where_exp: 'post', 'post.url != page.url and post.published != false' %}
  {% assign matching_posts = '' | split: '' %}
  {% assign other_posts = '' | split: '' %}
  {% for post in more_posts %}
    {% assign shares_topic = false %}
    {% for tag in post.tags %}
      {% if page.tags contains tag -%}
        {%- assign shares_topic = true -%}
        {%- break -%}
      {%- endif %}
    {% endfor %}
    {% if shares_topic %}
      {% assign matching_posts = matching_posts | push: post %}
    {% else %}
      {% assign other_posts = other_posts | push: post %}
    {% endif %}
  {% endfor %}
  {% assign more_posts = matching_posts | concat: other_posts %}
  {% assign related_limit = site.related_blog_posts.max_related | default: 2 | plus: 0 | at_most: 2 %}
  {% if site.related_blog_posts.enabled and related_limit > 0 and more_posts.size > 0 %}
    <section class="article-next">
      <h2>{{ 'labels.keep_reading' | ui_label }}</h2>
      {% for post in more_posts limit: related_limit -%}
        <a href="{{ post.url | relative_url }}" class="next-post"
          ><span>{% include content-date.liquid value=post.date %}</span>
          <h3 data-pretext>{{ post.title }}</h3>
          <span aria-hidden="true">↗</span></a
        >
      {%- endfor %}
    </section>
  {% endif %}
  {% if site.giscus.repo and page.giscus_comments %}{% include giscus.liquid %}{% endif %}
  {% if site.disqus_shortname and page.disqus_comments %}{% include disqus.liquid %}{% endif %}
</article>
