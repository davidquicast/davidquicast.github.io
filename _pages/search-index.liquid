{%- if site.enable_darkmode -%}
  , {"title":{{ 'theme.to_light' | ui_label: 'Light theme' | jsonify }},"type":"Action","action":"light"}, {"title":
  {{- 'theme.to_dark' | ui_label: 'Dark theme' | jsonify -}}
  ,"type":"Action","action":"dark"}, {"title":{{ 'theme.system' | ui_label: 'System theme' | jsonify }},"type":"Action","action":"system"}
{%- endif -%}
{%- if site.socials_in_search -%}
  {%- for profile in site.data.profile_links -%}
    , {"title":{{ profile.label | jsonify }},"description":{{ '' | jsonify }},"url":{{ profile.url | jsonify }},"type":"Profile"}
  {%- endfor -%}
{%- endif -%}
{%- for project in site.projects -%}
  {%- if project.published != false -%}
    , {"title":{{ project.title | jsonify }},"description":{{ project.description | strip_html | default: '' | jsonify }},"url":
    {{- project.url | locale_url: site.active_lang | jsonify -}}
    ,"type":"Project","lang":{{ project | content_locale | locale_tag | jsonify }},"tags":{{ project.tags | join: ' ' | jsonify }}}
  {%- endif -%}
{%- endfor -%}
{%- for post in site.posts -%}
  {%- if post.published != false -%}
    , {"title":{{ post.title | jsonify }},"description":{{ post.description | strip_html | default: '' | jsonify }},"url":
    {{- post.url | locale_url: site.active_lang | jsonify -}}
    ,"type":"Article","lang":{{ post | content_locale | locale_tag | jsonify }},"tags":{{ post.tags | join: ' ' | jsonify }}}
  {%- endif -%}
{%- endfor %}
{%- for paper in site.data.research.entries -%}
  , {"title":{{ paper.title | jsonify }},"description":{{ paper.summary | default: paper.abstract | jsonify }},"url":
  {{- paper.detail_url | locale_url: site.active_lang | jsonify -}}
  ,"type":"Research","tags":{{ paper.relationship | append: ' ' | append: paper.venue | jsonify }}}
{%- endfor %}
